#
# Copy this file to server/.env and fill in your key. NEVER commit server/.env.
# The key is used ONLY by this server process — it is never sent to the browser.
#
# Get a key at https://console.anthropic.com/  (format: sk-ant-… , long string)
ANTHROPIC_API_KEY=

# Optional overrides
# AI_MODEL=claude-haiku-4-5     # cost-first default; raise to claude-sonnet-5 / claude-opus-5
# AI_EFFORT=low                 # thinking effort (non-Haiku models only)
# AI_MONTHLY_TOKEN_CAP=2000000  # monthly token budget; over cap → 429 {fallback:true}
# AI_RATE_PER_MIN=20            # per-IP requests/min; over limit → 429 {fallback:true}
# PORT=8787
# CORS_ORIGIN=http://localhost:8915
